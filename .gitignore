# === 敏感文件排除 ===
# 运行时配置（含 token/cookie/session）
config.json
*.config.json
~/.config/iris/

# 环境变量 / 密钥
.env
.env.*
*.key
*.pem
*.p12
secrets/

# 日志
*.log
logs/
server.log

# 运行时数据 / DB
*.db
*.sqlite
*.sqlite3
sandbox/
runtime/

# 编译产物
iris
*.exe
bin/
dist/

# 会话 / cookie
*.session
*.cookie
session_*
cookies/

# IDE / 编辑器
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
