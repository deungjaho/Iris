[Unit]
Description=Iris WeChat Remote Control (claude code via WeChat)
After=network.target

[Service]
Type=simple
ExecStart={{HOME}}/.local/bin/iris -v
Restart=always
RestartSec=5
Environment=HOME={{HOME}}
Environment=PATH={{HOME}}/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HTTP_PROXY=http://127.0.0.1:7890
Environment=HTTPS_PROXY=http://127.0.0.1:7890
Environment=NO_PROXY=127.0.0.1,localhost,::1
StandardOutput=append:{{HOME}}/.local/share/iris/server.log
StandardError=append:{{HOME}}/.local/share/iris/server.log

[Install]
WantedBy=default.target
